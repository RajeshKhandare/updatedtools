# Optional monetization configuration
# Amazon India Associates tracking tag. This is used by the Cloudflare Worker
# to ensure every Amazon product click carries your affiliate attribution.
AMAZON_ASSOCIATE_TAG=innovative067-21

# Amazon Creators API credentials.
# NEVER expose these in NEXT_PUBLIC_* variables or commit real values.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=

# Set this in Vercel only after AdSense provides your publisher ID.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Canonical site identity.
# Keep NEXT_PUBLIC_SITE_URL unset until the final production domain is purchased and connected.
NEXT_PUBLIC_SITE_NAME=Toolployee
NEXT_PUBLIC_SITE_URL=

# Optional measurement / SEO verification
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Festival affiliate products use the Amazon Creators API at runtime.
# If the API is unavailable, curated Amazon fallback products/search links are shown.
