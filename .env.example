# Optional monetization configuration
# Amazon India Associates tracking tag (for example: yourtag-21).
# Keep blank until your Associates account/tag is ready.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Set this in Vercel only after AdSense provides your publisher ID.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Canonical site identity.
# Keep NEXT_PUBLIC_SITE_URL unset until the final production domain is purchased and connected.
NEXT_PUBLIC_SITE_NAME=Toolployee
NEXT_PUBLIC_SITE_URL=

# Optional measurement / SEO verification
# GA4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
