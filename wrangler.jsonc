{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "updatedtools",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
