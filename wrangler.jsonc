{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "updatedtools",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/en/*",
      "/pt/*",
      "/es/*",
      "/de/*",
      "/fr/*",
      "/it/*",
      "/ja/*",
      "/ko/*",
      "/zh/*",
      "/ru/*",
      "/ar/*",
      "/hi/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
